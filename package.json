{
  "name": "ollama-hub",
  "version": "1.0.0",
  "description": "A lightweight, beautiful, and secure memory-only web interface for local Ollama LLMs.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i ./src/styles/index.css -o ./public/styles/app.css --minify && esbuild ./src/highlight.js --bundle --format=iife --outfile=./public/vendor/highlight-browser.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fontsource/inter": "^5.2.8",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
